<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="local_debug_login_web_login" inherit_id="web.login">
        <xpath expr="//div[@id='oe_structure_login_bottom']" position="before">
            <t t-if="local_debug.get('enabled')">
                <div class="mt-4 pt-3 border-top">
                    <div class="small text-muted text-uppercase mb-3">Local Debug</div>

                    <form action="/local_debug/switch" method="get" class="mb-3">
                        <input type="hidden" name="redirect" t-att-value="redirect"/>
                        <label for="local_debug_internal_user" class="form-label">Internal User</label>
                        <div class="input-group">
                            <select
                                id="local_debug_internal_user"
                                name="user_id"
                                class="form-select"
                                required="required"
                            >
                                <option
                                    t-foreach="local_debug.get('internal_users', [])"
                                    t-as="user"
                                    t-key="'internal_%s' % user['id']"
                                    t-att-value="user['id']"
                                    t-att-selected="user['id'] == local_debug.get('default_uid') and 'selected' or None"
                                >
                                    <t t-esc="user['label']"/>
                                </option>
                            </select>
                            <button type="submit" class="btn btn-outline-primary">Login</button>
                        </div>
                    </form>

                    <form
                        t-if="local_debug.get('show_portal') and local_debug.get('portal_users')"
                        action="/local_debug/switch"
                        method="get"
                    >
                        <input type="hidden" name="redirect" t-att-value="redirect"/>
                        <label for="local_debug_portal_user" class="form-label">Portal User</label>
                        <div class="input-group">
                            <select
                                id="local_debug_portal_user"
                                name="user_id"
                                class="form-select"
                                required="required"
                            >
                                <option
                                    t-foreach="local_debug.get('portal_users', [])"
                                    t-as="user"
                                    t-key="'portal_%s' % user['id']"
                                    t-att-value="user['id']"
                                >
                                    <t t-esc="user['label']"/>
                                </option>
                            </select>
                            <button type="submit" class="btn btn-outline-secondary">Login</button>
                        </div>
                    </form>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
